# Bu dosyayı ".env" olarak kopyalayin ve kendi degerlerinizi girin.
# .env dosyasi ASLA Git'e yuklenmemelidir.

# Flask
SECRET_KEY=degistir-bu-anahtari-uretimde
FLASK_ENV=development

# Veritabani
DATABASE_URL=tesseract.db

# Yapay Zeka (Groq)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_buraya_kendi_anahtarinizi_yapistirin
GROQ_MODEL=llama-3.1-8b-instant

# CORS - Wix sitenizin adresi (virgul ile birden fazla eklenebilir)
CORS_ORIGINS=*
